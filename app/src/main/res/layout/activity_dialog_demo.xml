<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="96dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_dialog_lab_title"
            android:textColor="@color/demo_primary_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/demo_dialog_lab_intro"
            android:textColor="@color/demo_secondary_text"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/demo_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E6EAF2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_dialog_group_common"
                    android:textColor="@color/demo_primary_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCommon"
                    style="@style/DemoMaterialButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/demo_dialog_common"
                    app:icon="@drawable/ic_md_dialog" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnColor"
                    style="@style/DemoMaterialButton"
                    android:text="@string/demo_dialog_color"
                    app:icon="@drawable/ic_md_palette" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLong"
                    style="@style/DemoMaterialButton"
                    android:text="@string/demo_dialog_long_text"
                    app:icon="@drawable/ic_md_view" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/demo_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E6EAF2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_dialog_group_scene"
                    android:textColor="@color/demo_primary_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoading"
                    style="@style/DemoMaterialButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/demo_dialog_loading"
                    app:icon="@drawable/ic_md_loading" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPermission"
                    style="@style/DemoMaterialButton"
                    android:text="@string/demo_dialog_permission"
                    app:icon="@drawable/ic_md_permission" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustom"
                    style="@style/DemoMaterialButton"
                    android:text="@string/demo_dialog_custom"
                    app:icon="@drawable/ic_md_view" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRaw"
                    style="@style/DemoMaterialButton"
                    android:text="@string/demo_dialog_raw"
                    app:icon="@drawable/ic_md_widgets" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
